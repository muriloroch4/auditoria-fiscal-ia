{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditoria-fiscal-ia.local/schemas/auditoria_anual.v1.schema.json",
  "title": "JSON de auditoria contabil anual comparativa",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_schema_version",
    "meta",
    "identificacao",
    "risco_anual",
    "metricas_anual",
    "comparativo_trimestral",
    "achados_anuais",
    "resumo_evolucao",
    "consultivo"
  ],
  "properties": {
    "_schema_version": { "const": "annual-1.1.0" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versao_schema",
        "data_analise",
        "total_trimestres_informados",
        "trimestres_ausentes",
        "fontes"
      ],
      "properties": {
        "versao_schema": { "const": "annual-1.1.0" },
        "data_analise": { "type": "string" },
        "total_trimestres_informados": { "type": "integer", "minimum": 1, "maximum": 4 },
        "trimestres_ausentes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fontes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "identificacao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cliente", "cnpj", "regime_tributario", "exercicio", "periodos_analisados"],
      "properties": {
        "cliente": { "type": "string" },
        "cnpj": { "type": "string" },
        "regime_tributario": { "type": "string" },
        "exercicio": { "type": "string" },
        "periodos_analisados": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "risco_anual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nivel_geral", "pontuacao_total", "modalidade_opiniao_sugerida", "explicacao_pontuacao", "classificacao"],
      "properties": {
        "nivel_geral": { "$ref": "#/$defs/risco" },
        "pontuacao_total": { "type": "integer", "minimum": 0 },
        "modalidade_opiniao_sugerida": {
          "type": "string",
          "enum": ["sem_ressalva", "com_ressalva", "adversa", "abstencao_opiniao"]
        },
        "explicacao_pontuacao": {
          "type": "array",
          "items": { "type": "string" }
        },
        "classificacao": { "$ref": "#/$defs/classificacao_achados" }
      }
    },
    "metricas_anual": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "receita_servicos_total",
        "deducoes_receita_total",
        "tributos_registrados_total",
        "despesas_operacionais_total",
        "lucro_apurado_total",
        "indicadores_derivados"
      ],
      "properties": {
        "receita_servicos_total": { "$ref": "#/$defs/metrica" },
        "deducoes_receita_total": { "$ref": "#/$defs/metrica" },
        "tributos_registrados_total": { "$ref": "#/$defs/metrica" },
        "despesas_operacionais_total": { "$ref": "#/$defs/metrica" },
        "lucro_apurado_total": { "$ref": "#/$defs/metrica" },
        "indicadores_derivados": {
          "type": "object",
          "additionalProperties": { "type": ["string", "boolean", "number", "integer", "null"] }
        }
      }
    },
    "comparativo_trimestral": {
      "type": "array",
      "items": { "$ref": "#/$defs/trimestre" }
    },
    "achados_anuais": {
      "type": "array",
      "items": { "$ref": "#/$defs/achado_anual" }
    },
    "resumo_evolucao": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tendencia_risco", "achados_recorrentes", "total_achados_anuais"],
      "properties": {
        "tendencia_risco": { "type": "string" },
        "achados_recorrentes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["codigo", "trimestres"],
            "properties": {
              "codigo": { "type": "string" },
              "trimestres": { "type": "integer", "minimum": 2 }
            }
          }
        },
        "total_achados_anuais": { "type": "integer", "minimum": 0 }
      }
    },
    "consultivo": { "$ref": "#/$defs/consultivo_anual" }
  },
  "$defs": {
    "risco": {
      "type": "string",
      "enum": ["alto", "medio", "baixo"]
    },
    "classificacao_achados": {
      "type": "object",
      "additionalProperties": false,
      "required": ["achados_alto", "achados_medio", "achados_baixo"],
      "properties": {
        "achados_alto": { "type": "integer", "minimum": 0 },
        "achados_medio": { "type": "integer", "minimum": 0 },
        "achados_baixo": { "type": "integer", "minimum": 0 }
      }
    },
    "metrica": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "formatado"],
      "properties": {
        "valor": { "type": "number" },
        "formatado": { "type": "string" }
      }
    },
    "trimestre": {
      "type": "object",
      "additionalProperties": true,
      "required": ["trimestre", "ordem", "periodo", "risco", "pontuacao", "metricas", "achados", "achados_codigos"],
      "properties": {
        "trimestre": { "type": "string" },
        "ordem": { "type": "integer", "minimum": 1 },
        "periodo": { "type": "string" },
        "risco": { "$ref": "#/$defs/risco" },
        "pontuacao": { "type": "integer", "minimum": 0 },
        "metricas": {
          "type": "object",
          "additionalProperties": { "type": ["number", "integer", "string", "null"] }
        },
        "achados": {
          "type": "array",
          "items": { "type": "object" }
        },
        "achados_codigos": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "achado_anual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codigo", "titulo", "nivel", "pontuacao", "descricao", "evidencia", "recomendacao", "normas_aplicaveis"],
      "properties": {
        "codigo": { "type": "string" },
        "titulo": { "type": "string" },
        "nivel": { "$ref": "#/$defs/risco" },
        "pontuacao": { "type": "integer", "minimum": 0 },
        "descricao": { "type": "string" },
        "evidencia": { "$ref": "#/$defs/evidencia_estruturada" },
        "recomendacao": { "type": "string" },
        "normas_aplicaveis": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "evidencia_estruturada": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fonte_dado", "confianca", "necessita_documento", "documentos_recomendados", "campos_extraidos"],
      "properties": {
        "fonte_dado": { "type": "string" },
        "confianca": {
          "type": "string",
          "enum": ["alta", "media", "baixa"]
        },
        "necessita_documento": { "type": "boolean" },
        "documentos_recomendados": {
          "type": "array",
          "items": { "type": "string" }
        },
        "campos_extraidos": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "integer", "boolean", "null"] }
        }
      }
    },
    "consultivo_anual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leitura_cliente", "proximos_passos", "plano_acao_anual"],
      "properties": {
        "leitura_cliente": { "type": "string" },
        "proximos_passos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "plano_acao_anual": {
          "type": "array",
          "items": { "$ref": "#/$defs/acao_consultiva_anual" }
        }
      }
    },
    "acao_consultiva_anual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codigo",
        "prioridade",
        "ponto_atencao",
        "o_que_significa",
        "como_solucionar",
        "documentos_necessarios",
        "responsavel_sugerido",
        "prazo_sugerido"
      ],
      "properties": {
        "codigo": { "type": "string" },
        "prioridade": {
          "type": "string",
          "enum": ["alta", "media", "baixa"]
        },
        "ponto_atencao": { "type": "string" },
        "o_que_significa": { "type": "string" },
        "como_solucionar": { "type": "string" },
        "documentos_necessarios": {
          "type": "array",
          "items": { "type": "string" }
        },
        "responsavel_sugerido": { "type": "string" },
        "prazo_sugerido": { "type": "string" }
      }
    }
  }
}
