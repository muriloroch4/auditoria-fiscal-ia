# OpenRouter API Key (obter em https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Chave opcional para proteger a API local (/api/auditorias)
AUDIT_API_KEY=dev-local-secret

# Modelo de IA (padrão: nvidia/nemotron-3-super-120b-a12b:free)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Máximo de tokens na resposta (padrão: 2048)
OPENROUTER_MAX_TOKENS=2048
